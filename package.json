{
  "name": "soil-intelligence",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-braces.mjs",
    "predev": "npm run security:patch",
    "prebuild": "npm run security:patch",
    "prestart": "npm run security:patch",
    "prelint": "npm run security:patch",
    "security:patch": "node scripts/patch-braces.mjs",
    "security:check": "node scripts/patch-braces.mjs --check && node --test tests/braces-security.test.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run privacy:check && npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "demo:generate": "node scripts/generate-demo-data.mjs",
    "db:migrate": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler d1 migrations apply soil-intelligence --local",
    "typecheck": "tsc --noEmit",
    "privacy:check": "node scripts/check-public-data.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.1.0",
    "vite": "8.3.4",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "fflate": "0.7.5",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "license": "MIT",
  "type": "module",
  "description": "Open-source soil test mapping and nutrient planning with synthetic demo data"
}
